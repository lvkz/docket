#!/usr/bin/env python3
"""Send a desktop notification for each khal event's reminders.

Run once a minute (docket-notify.timer). An event's own alerts (pop-up VALARMs relative to its
start, as set on a phone or in Google) are used when it has any. Otherwise timed events get
reminderMinutes before they start (default 10) and all-day events get one at 09:00 that day.
reminderMinutes 0 turns every reminder off; reminderCalendarsOff mutes calendars. Both come
from ~/.config/docket/config.json, the file Docket's Settings write. Remembers what it already
announced in $XDG_STATE_HOME/docket/notified.json.
"""

import json
import os
import subprocess
import sys
from datetime import datetime, timedelta
from pathlib import Path

KHAL_FORMAT = "%Y-%m-%d %H:%M"  # khal [locale] datetimeformat
FIELDS = ["uid", "title", "start", "end", "all-day", "location", "calendar", "alarms-list"]
ALL_DAY_HOUR = 9  # default reminder for an all-day event without its own alerts
LOOKAHEAD_DAYS = 8  # covers alerts up to a week before the event
CONFIG = Path(os.environ.get("DOCKET_CONFIG")
              or Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "docket/config.json")
STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "docket/notified.json"


def khal_events():
    cmd = ["khal", "list", "--once"]
    for field in FIELDS:
        cmd += ["--json", field]
    cmd += ["today", f"{LOOKAHEAD_DAYS}d"]
    result = subprocess.run(cmd, capture_output=True, text=True, check=False)
    if result.returncode != 0:
        sys.exit(f"docket-notify: khal list failed ({result.returncode}): {result.stderr.strip()}")
    # khal prints one JSON array per day; an empty window prints nothing
    events = []
    for line in result.stdout.splitlines():
        if line.strip():
            events += json.loads(line)
    return events


def load_config():
    try:
        config = json.loads(CONFIG.read_text())
    except FileNotFoundError:
        return 10, set()
    except json.JSONDecodeError as error:
        sys.exit(f"docket-notify: {CONFIG} is not valid JSON: {error}")
    minutes = config.get("reminderMinutes", 10)
    if not isinstance(minutes, int) or minutes < 0:
        sys.exit(f"docket-notify: reminderMinutes in {CONFIG} must be a whole number >= 0")
    return minutes, set(config.get("reminderCalendarsOff", []))


def reminders(event, lead):
    """Minutes before the event's start (midnight for all-day events) at which to remind."""
    own = [-alarm["delta"] / 60 for alarm in event.get("alarms-list") or [] if alarm["delta"] <= 0]
    if own:
        return sorted({round(minutes) for minutes in own})
    return [-ALL_DAY_HOUR * 60] if event["all-day"] == "True" else [lead]


def due(events, now, lead, notified, muted=frozenset()):
    """(keys, start, event) per event with reminders whose time has come and that weren't
    announced yet. A reminder stays due until the event starts (all-day: until its day ends);
    several due at once (e.g. after a suspend) make one notification."""
    found = []
    for event in events:
        if event["calendar"] in muted:
            continue
        all_day = event["all-day"] == "True"
        start = datetime.strptime(event["start"], "%Y-%m-%d" if all_day else KHAL_FORMAT)
        # due until the event's start minute is over (all-day: until its day is over)
        over = start + (timedelta(days=1) if all_day else timedelta(minutes=1))
        keys = [f"{event['uid']}|{event['start']}|{minutes}" for minutes in reminders(event, lead)
                if start - timedelta(minutes=minutes) <= now < over]
        fresh = [key for key in keys if key not in notified]
        if fresh:
            found.append((fresh, start, event))
    return found


def until(start, now):
    minutes = max(0, round((start - now).total_seconds() / 60))
    if minutes < 60:
        return f"in {minutes} min"
    if minutes < 48 * 60:
        return f"in {round(minutes / 60)} h"
    return f"in {round(minutes / 1440)} days"


def notify(start, event, now):
    if event["all-day"] == "True":
        days = (start.date() - now.date()).days
        body = "All day · " + ("today" if days <= 0 else "tomorrow" if days == 1 else f"in {days} days")
    else:
        end = event["end"].split(" ")[-1]
        body = f"{start:%H:%M}–{end} · {until(start, now)}"
    if event["location"]:
        body += f"\n{event['location']}"
    subprocess.run(["notify-send", "-a", "Docket", "-i", "x-office-calendar",
                    event["title"] or "(untitled)", body], check=True)


def load_notified(now):
    try:
        data = json.loads(STATE.read_text())
    except FileNotFoundError:
        return {}
    cutoff = (now - timedelta(days=LOOKAHEAD_DAYS + 1)).isoformat()
    return {key: stamp for key, stamp in data.items() if stamp > cutoff}


def main():
    lead, muted = load_config()
    if lead == 0:
        return
    now = datetime.now().replace(second=0, microsecond=0)
    notified = load_notified(now)
    for keys, start, event in due(khal_events(), now, lead, notified, muted):
        notify(start, event, now)
        notified.update({key: now.isoformat() for key in keys})
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(notified))


if __name__ == "__main__":
    main()
